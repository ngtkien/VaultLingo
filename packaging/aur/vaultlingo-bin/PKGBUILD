# Maintainer: Zeder <ngtkien95@gmail.com>
pkgname=vaultlingo-bin
pkgver=0.1.5
pkgrel=1
pkgdesc="Daily AI English & Obsidian Vault Sync (Pre-built binary)"
arch=('x86_64')
url="https://github.com/ngtkien/VaultLingo"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1')
optdepends=('obsidian: For markdown vault note sync')
provides=('vaultlingo' 'vl')
conflicts=('vaultlingo')
source_x86_64=("https://github.com/ngtkien/VaultLingo/releases/download/v${pkgver}/vaultlingo-v${pkgver}-linux-x86_64.tar.gz")
sha256sums_x86_64=('080694c4391757e7e09b7e6d73abce04ebc7e109f74710aab896b087650e0404')

package() {
    cd "${srcdir}/vaultlingo-v${pkgver}-linux-x86_64"

    install -Dm755 vaultlingo "${pkgdir}/usr/bin/vaultlingo"
    install -Dm755 vl "${pkgdir}/usr/bin/vl"
    install -Dm644 vaultlingo.desktop "${pkgdir}/usr/share/applications/vaultlingo.desktop"
    install -Dm644 vaultlingo.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/vaultlingo.png"
}
